# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments. Two of them: .venv runs the plugin tests on 3.10, and .venv-spatial runs
# test-importer-to-viewer.ipynb, which needs 3.12 for the cell-painting-io reader.
.venv
.venv-spatial

# OS
.DS_Store

# Where spatialdata-plot and scanpy put figures when asked to save one
figures/

# CellProfiler run outputs (regenerate by re-running the pipeline; not source)
Testrun_cp2sd_*.csv
Testrun_cp2sd_*.h5ad

# ExportForSpatialData run output (regenerate by re-running the pipeline; not source).
# Root-anchored on purpose: an unanchored *_export/ also matches cp_plugins/scverse_export/ and
# silently untracks source files added to it.
/*_export/

# BBBC021 example data: downloaded from the Broad Bioimage Benchmark Collection, ~2.6 GB.
/BBBC021_v1_*.csv
/BBBC021_v1_images_*.zip
/Week1_*/
